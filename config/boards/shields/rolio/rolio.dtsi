#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix_transform = &default_transform;
        zmk,backlight = &backlight;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <16>;
        rows = <4>;
// | SW_A0 | SW_B0 | SW_C0 | SW_D0 | SW_E0 | SW_F0 |                   | SW_F0 | SW_E0 | SW_D0 | SW_C0 | SW_B0 | SW_A0 |
// | SW_A1 | SW_B1 | SW_C1 | SW_D1 | SW_E1 | SW_F1 |                   | SW_F1 | SW_E1 | SW_D1 | SW_C1 | SW_B1 | SW_A1 |
// | SW_A2 | SW_B2 | SW_C2 | SW_D2 | SW_E2 | SW_F2 | RE_1  |   | RE_1  | SW_F2 | SW_E2 | SW_D2 | SW_C2 | SW_B2 | SW_A2 |
//                 | SW_B4 | SW_B3 | SW_C3 | SW_D3 | SW_E3 |   | SW_E3 | SW_D3 | SW_C3 | SW_B3 | SW_B4 |
        map = <
RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)                    RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11)
RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)                    RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11)
RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(3,0)   RC(3,11) RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11)
                RC(3,2) RC(3,3) RC(3,4) RC(3,5) RC(3,1)   RC(3,10) RC(3,6) RC(3,7) RC(3,8) RC(3,9)
        >;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        label = "KSCAN";

        diode-direction = "col2row";
        row-gpios
            = <&pro_micro 5 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 7 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 8 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 9 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            ;
    };

    physical_layout0: physical_layout_0 {
        compatible = "zmk,physical-layout";
        display-name = "Default Layout";
        keys  //                   w   h    x       y     rot    rx    ry
            = <&key_physical_attrs 1   0      0     0       0     0     0>
            , <&key_physical_attrs 2   0    100     0       0     0     0>
            , <&key_physical_attrs 3   0    200     0       0     0     0>
            , <&key_physical_attrs 4   0    300     0       0     0     0>
            , <&key_physical_attrs 5   0    400     0       0     0     0>
            , <&key_physical_attrs 6   0    500     0       0     0     0>

            , <&key_physical_attrs 9   0    900     0       0     0     0>
            , <&key_physical_attrs 10  0    1000     0       0     0     0>
            , <&key_physical_attrs 11  0    1100     0       0     0     0>
            , <&key_physical_attrs 12  0    1200     0       0     0     0>
            , <&key_physical_attrs 13  0    1300    0       0     0     0>
            , <&key_physical_attrs 14  0    1400    0       0     0     0>

            
            , <&key_physical_attrs 1   1      0    100       0     0     0>
            , <&key_physical_attrs 2   1    100    100       0     0     0>
            , <&key_physical_attrs 3   1    200    100       0     0     0>
            , <&key_physical_attrs 4   1    300    100       0     0     0>
            , <&key_physical_attrs 5   1    400    100       0     0     0>
            , <&key_physical_attrs 6   1    500    100       0     0     0>

            , <&key_physical_attrs 9   1    900    100       0     0     0>
            , <&key_physical_attrs 10  1    1000    100       0     0     0>
            , <&key_physical_attrs 11  1    1100    100       0     0     0>
            , <&key_physical_attrs 12  1    1200    100       0     0     0>
            , <&key_physical_attrs 13  1    1300   100       0     0     0>
            , <&key_physical_attrs 14  1    1400   100       0     0     0>


            , <&key_physical_attrs 1   2      0    200       0     0     0>
            , <&key_physical_attrs 2   2    100    200       0     0     0>
            , <&key_physical_attrs 3   2    200    200       0     0     0>
            , <&key_physical_attrs 4   2    300    200       0     0     0>
            , <&key_physical_attrs 5   2    400    200       0     0     0>
            , <&key_physical_attrs 6   2    500    200       0     0     0>
            , <&key_physical_attrs 7   2    600    200       0     0     0>
            
            , <&key_physical_attrs 8   2    800    200       0     0     0>
            , <&key_physical_attrs 9   2    900    200       0     0     0>
            , <&key_physical_attrs 10  2    1000    200       0     0     0>
            , <&key_physical_attrs 11  2    1100    200       0     0     0>
            , <&key_physical_attrs 12  2    1200    200       0     0     0>
            , <&key_physical_attrs 13  2    1300    200       0     0     0>
            , <&key_physical_attrs 14  2    1400    200       0     0     0>


            , <&key_physical_attrs 3   3    200    300       0     0     0>
            , <&key_physical_attrs 4   3    300    300       0     0     0>
            , <&key_physical_attrs 5   3    400    300       0     0     0>
            , <&key_physical_attrs 6   3    500    300       0     0     0>
            , <&key_physical_attrs 7   3    600    300       0     0     0>

            , <&key_physical_attrs 8   3    800    300       0     0     0>
            , <&key_physical_attrs 9   3    900    300       0     0     0>
            , <&key_physical_attrs 10  3    1000    300       0     0     0>
            , <&key_physical_attrs 11  3    1100    300       0     0     0>
            , <&key_physical_attrs 12  3    1200    300       0     0     0>        
            ;
    };

    encoder_left: encoder_left {
        compatible = "alps,ec11";
        label = "LEFT_ENCODER";
        a-gpios = <&pro_micro 21 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        b-gpios = <&pro_micro 20 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        steps = <60>;
        status = "disabled";
    };

    encoder_right: encoder_right {
        compatible = "alps,ec11";
        label = "RIGHT_ENCODER";
        a-gpios = <&pro_micro 21 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        b-gpios = <&pro_micro 20 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        steps = <60>;
        status = "disabled";
    };

    sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&encoder_left &encoder_right>;
        triggers-per-rotation = <15>;
    };

    backlight: pwmleds {
        compatible = "pwm-leds";
        pwm_led_0 {
            pwms = <&pwm0 0 10000 PWM_POLARITY_NORMAL>;
        };
    };

};