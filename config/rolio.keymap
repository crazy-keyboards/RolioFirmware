#include "zmk-helpers/helper.h"
#include "zmk-helpers/key-labels/rolio46.h"
#include "behaviors.dtsi"
#include "dt-bindings/zmk/backlight.h"
#include "dt-bindings/zmk/bt.h"
#include "dt-bindings/zmk/keys.h"
#include "dt-bindings/zmk/outputs.h"
#include "locale/keys_ru.h"
#include "custom-behaviors.dtsi"
#include "custom-macros.dtsi"
#include "combos.dtsi"

#define ENG       0
#define RUS       1
#define FKEYS     2
#define NUMBERS   3
#define MATHS     4
#define KB_CONFIG 5

&sk {
    release-after-ms = <2000>;
    lazy;
};

/ {

    behaviors {
       
        // Toggle Numbers layer

        td_math_numbers: tap_dance_math_numbers {
            compatible = "zmk,behavior-tap-dance";
            label = "TAP_DANCE_MATS_NUMBERS";
            #binding-cells = <0>;
            tapping-term-ms = <300>;
            bindings = <&mo NUMBERS>, <&tog MATHS>, <&tog NUMBERS>;
        };

        td_math_numbers_rus: tap_dance_math_numbers_rus {
            compatible = "zmk,behavior-tap-dance";
            label = "TAP_DANCE_MATS_NUMBERS_RUS";
            #binding-cells = <0>;
            tapping-term-ms = <300>;
            bindings = <&m_numbers_rus>, <&tog MATHS>, <&tog NUMBERS>;
        };

        // Word Seek

        word_seek: word_seek {
            compatible = "zmk,behavior-sensor-rotate";
            label = "WORD_SEEK";
            #sensor-binding-cells = <0>;
            tap-ms = <20>;
            bindings = <&prev_word>, <&next_word>;
        };

        //OS Zoom

        zoom: zoom {
            compatible = "zmk,behavior-sensor-rotate";
            label = "WINDOWS_ZOOM";
            #sensor-binding-cells = <0>;
            bindings = <&zoom_in>, <&zoom_out>;
        };

        td_e_yo: td_e_yo {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_E_YO";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp RU_CYRILLIC_IE>, <&kp RU_CYRILLIC_IO>;
        };

        td_mzn_tzn: td_mzn_tzn {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_MZN_TZN";
            #binding-cells = <0>;
            tapping-term-ms = <175>;
            bindings = <&kp M>, <&kp RBKT>;
        };

        ht_hrm_left: ht_hrm_left {
            compatible = "zmk,behavior-hold-tap";
            label = "HT_HRM_LEFT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <300>;
            flavor = "balanced";
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <37 23 11 10 22 36 35 21 9 8 20 34 33 19 7 6 18 32 31 43 44 45 46 47>;
        };

        ht_hrm_right: ht_hrm_right {
            compatible = "zmk,behavior-hold-tap";
            label = "HT_HRM_RIGHT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <300>;
            flavor = "balanced";
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <42 30 29 41 17 5 4 16 28 40 39 27 15 3 2 14 26 38 25 13 1 0 12 24>;
        };

        shft_cpsw: td_shift_capsw {
            compatible = "zmk,behavior-tap-dance";
            label = "TAP_DANCE_LSHIFT_CAPSWORD";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp LSHFT>, <&caps_word>;
        };

        HOLD_COMBO_BEHAVIOR(htnumbers_rus, <&m_numbers_rus>) // macro_numbers_rus on hold and kp on tap
    };

    macros {
        unindent: unindent {
            label = "UNINDENT";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LSHIFT>,
                <&macro_tap>,
                <&kp TAB>,
                <&macro_release>,
                <&kp LSHIFT>;
        };

        lstart: lstart {
            label = "Line_Start";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LGUI>,
                <&macro_tap>,
                <&kp LEFT>,
                <&macro_release>,
                <&kp LGUI>;
        };

        lend: lend {
            label = "Line_End";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LGUI>,
                <&macro_tap>,
                <&kp RIGHT>,
                <&macro_release>,
                <&kp LGUI>;
        };

        scrsh: scrsh {
            label = "Screenshot";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LGUI>,
                <&macro_press>,
                <&kp LSHIFT>,
                <&macro_tap>,
                <&kp N3>,
                <&macro_release>,
                <&kp LSHFT>,
                <&macro_release>,
                <&kp LGUI>;
        };

        scrcr: scrcr {
            label = "Windows_Screen_Crop";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LGUI>,
                <&macro_press>,
                <&kp LSHIFT>,
                <&macro_tap>,
                <&kp S>,
                <&macro_release>,
                <&kp LSHFT>,
                <&macro_release>,
                <&kp LGUI>;
        };

        pal: pal {
            label = "Pallette";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LGUI>,
                <&macro_tap>,
                <&kp DOT>,
                <&macro_release>,
                <&kp LGUI>;
        };

        // Word seek macros

        prev_word: prev_word {
            label = "PREV_WORD";
            compatible = "zmk,behavior-macro";
            wait-ms = <2>;
            tap-ms = <20>;
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_tap>,
                <&kp LEFT>,
                <&macro_release>,
                <&kp LCTRL>;
        };

        next_word: next_word {
            label = "NEXT_WORD";
            compatible = "zmk,behavior-macro";
            wait-ms = <2>;
            tap-ms = <20>;
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_tap>,
                <&kp RIGHT>,
                <&macro_release>,
                <&kp LCTRL>;
        };

        // Zoom macros

        zoom_in: zoom_in {
            label = "WINDOWS_ZOOM_IN";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_tap>,
                <&kp EQUAL>,
                <&macro_release>,
                <&kp LCTRL>;
        };

        zoom_out: zoom_out {
            label = "WINDOWS_ZOOM_OUT";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_tap>,
                <&kp MINUS>,
                <&macro_release>,
                <&kp LCTRL>;
        };

        reset_zoom: reset_zoom {
            label = "WINDOWS_RESET_ZOOM";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_tap>,
                <&kp N0>,
                <&macro_release>,
                <&kp LCTRL>;
        };

        SWITCH_LANG_AND_MO_LAYER_MACRO(numbers_rus, NUMBERS, ENG_NUM, SECOND_NUM)
        SWITCH_LANG_AND_TO_LAYER_MACRO(tom_rus, RUS, SECOND_NUM)
        SWITCH_LANG_AND_TO_LAYER_MACRO(tom_eng, ENG, ENG_NUM)
        SWITCH_LANG_AND_KP_MACRO(kp_number, HASH, SECOND_NUM, ENG_NUM)

    };

    combos {
        compatible = "zmk,combos";

        combo_ZX_ctrlC {
            bindings = <&kp LC(Z)>;
            key-positions = <25 26>;
            layers = <ENG RUS>;
        };

        combo_XC_ctrlX {
            bindings = <&kp LC(X)>;
            key-positions = <26 27>;
            layers = <ENG RUS>;
        };

        combo_CV_ctrlC {
            bindings = <&kp LC(C)>;
            key-positions = <27 28>;
            layers = <ENG RUS>;
        };

        combo_VB_ctrlV {
            bindings = <&kp LC(V)>;
            key-positions = <29 28>;
            layers = <ENG RUS>;
        };

        combo_sk_win_left {
            bindings = <&sk LGUI>;
            key-positions = <38 39>;
        };

        combo_sk_alt_left {
            bindings = <&sk LALT>;
            key-positions = <39 40>;
        };
        
        combo_sk_ctrl_left {
            bindings = <&sk LCTL>;
            key-positions = <40 41>;
        };
        
        combo_sk_shift_left {
            bindings = <&sk LSHFT>;
            key-positions = <41 42>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            label = "QWERTY";
            sensor-bindings = <&inc_dec_kp UP DOWN &inc_dec_kp LEFT RIGHT>;
            bindings = <
&kp GRAVE   &kp Q   &kp W          &kp E       &kp R       &kp T                                 &kp Y             &kp U      &kp I       &kp O       &kp P       &kp BSPC
&kp TAB     &kp A   &kp S          &kp D       &kp F       &kp G                                 &kp H             &kp J      &kp K       &kp L       &kp SEMI    &kp SQT
&m_tom_eng  &kp Z   &kp X          &kp C       &kp V       &kp B       &kp F16         &kp F17   &kp N             &kp M      &kp COMMA   &kp DOT     &kp FSLH    &m_tom_rus
                    &mt LGUI DEL   &kp LALT    &kp LCTL    &shft_cpsw  &kp SPACE       &kp RET   &td_math_numbers  &mo FKEYS  &kp LBKT    &kp BSPC
            >;
        };

        ru_default_layer {
            label = "Russian";
            sensor-bindings = <&inc_dec_kp UP DOWN &inc_dec_kp LEFT RIGHT>;
            bindings = <
&trans  &kp RU_CYRILLIC_SHORT_I  &kp RU_CYRILLIC_TSE   &kp RU_CYRILLIC_U   &kp RU_CYRILLIC_KA  &td_e_yo                               &kp RU_CYRILLIC_EN    &kp RU_CYRILLIC_GHE             &kp RU_CYRILLIC_SHA        &kp RU_CYRILLIC_SHCHA      &kp RU_CYRILLIC_ZE   &trans
&trans  &kp RU_CYRILLIC_EF       &kp RU_CYRILLIC_YERU  &kp RU_CYRILLIC_VE  &kp RU_CYRILLIC_A   &kp RU_CYRILLIC_PE                     &kp RU_CYRILLIC_ER    &kp RU_CYRILLIC_O               &kp RU_CYRILLIC_EL         &kp RU_CYRILLIC_DE         &kp RU_CYRILLIC_ZHE  &kp FSLH
&trans  &kp RU_CYRILLIC_YA       &kp RU_CYRILLIC_CHE   &kp RU_CYRILLIC_ES  &kp RU_CYRILLIC_EM  &kp RU_CYRILLIC_I   &trans     &trans  &kp RU_CYRILLIC_TE    &kp RU_CYRILLIC_SOFT_SIGN       &kp RU_CYRILLIC_BE         &kp RU_CYRILLIC_YU         &kp RU_CYRILLIC_E    &trans
                                 &trans                &trans              &trans              &trans              &trans     &trans  &td_math_numbers_rus  &kp RU_CYRILLIC_HA              &kp RU_CYRILLIC_HARD_SIGN  &trans
            >;
        };

        fkeys_layer {
            label = "F Keys";
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &zoom>;
            bindings = <
&kp ESCAPE  &kp F1  &kp F2   &kp F3   &kp F4   &kp C_PP                               &none     &kp RSHIFT  &kp RCTRL  &kp RALT   &kp RGUI   &none
&bt BT_PRV  &kp F5  &kp F6   &kp F7   &kp F8   &kp C_NEXT                             &kp HOME  &kp UP      &kp END    &kp PSCRN  &kp PG_UP  &none
&bt BT_NXT  &kp F9  &kp F10  &kp F11  &kp F12  &kp C_PREV  &kp C_MUTE  &reset_zoom    &kp LEFT  &kp DOWN    &kp RIGHT  &scrcr     &kp PG_DN  &none
                    &trans   &trans   &trans   &trans      &trans      &trans         &trans    &trans      &trans     &trans
            >;
        };

        numbers_layer {
            label = "Numbers";
            sensor-bindings = <&inc_dec_kp UP DOWN &word_seek>;
            bindings = <
&kp UNDER  &kp N1    &kp N2          &kp N3           &kp N4    &kp N5                     &kp N6     &kp N7         &kp N8    &kp N9    &kp N0         &trans
&trans     &kp EXCL  &kp AT          &kp HASH         &kp DLLR  &kp PRCNT                  &kp CARET  &kp AMPERSAND  &kp STAR  &kp LPAR  &kp RPAR       &kp BACKSLASH
&trans     &pal      &kp LEFT_BRACE  &kp RIGHT_BRACE  &kp PIPE  &kp EQUAL  &trans  &trans  &kp MINUS  &kp PLUS       &kp LBKT  &kp RBKT  &kp FSLH       &kp DOT
                     &trans          &trans           &trans    &trans     &trans  &trans  &trans     &trans         &trans    &trans
            >;
        };

        maths_layer {
            label = "Maths";
            sensor-bindings = <&inc_dec_kp UP DOWN &inc_dec_kp LEFT RIGHT>;
            bindings = <
&trans     &trans    &trans  &trans  &trans  &trans                    &kp KP_MULTIPLY  &kp KP_N4     &kp KP_N5     &kp KP_N6    &kp KP_PLUS   &kp KP_NUM
&trans     &trans    &trans  &trans  &trans  &trans                    &kp KP_N0        &kp KP_N1     &kp KP_N2     &kp KP_N3    &kp KP_DOT    &kp C_AL_CALC
&trans     &trans    &trans  &trans  &trans  &trans  &trans    &trans  &kp KP_DIVIDE    &kp KP_N7     &kp KP_N8     &kp KP_N9    &kp KP_MINUS  &kp PRCNT
                     &trans  &trans  &trans  &trans  &trans    &trans  &tog MATHS       &trans        &trans        &trans
            >;
        };

//        maths_layer {
//            label = "Maths";
//            sensor-bindings = <&inc_dec_kp UP DOWN &inc_dec_kp LEFT RIGHT>;
//            bindings = <
//&kp UNDER  &kp N1    &kp N2  &kp N3  &kp N4  &kp N5                     &kp N6      &kp N7         &kp N8    &kp N9    &kp N0    &trans
//&trans     &kp EXCL  &trans  &trans  &trans  &kp PRCNT                  &kp CARET   &kp AMPERSAND  &kp STAR  &kp LPAR  &kp RPAR  &kp FSLH
//&trans     &pal      &trans  &trans  &trans  &kp EQUAL  &trans  &trans  &kp MINUS   &kp PLUS       &trans    &trans    &trans    &kp DOT
//                     &trans  &trans  &trans  &trans     &trans  &trans  &tog MATHS  &trans         &trans    &trans
//            >;
//        };

        settings_layer {
            label = "Settings";
            sensor-bindings = <&inc_dec_kp UP DOWN &inc_dec_kp LEFT RIGHT>;
            bindings = <
&out OUT_TOG  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                    &trans  &trans  &trans  &trans  &trans  &trans
&trans        &bt BT_PRV    &bt BT_NXT    &trans        &trans        &trans                          &trans  &trans  &trans  &trans  &trans  &trans
&trans        &trans        &bt BT_CLR    &bl BL_DEC    &bl BL_TOG    &bl BL_INC      &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                            &trans        &trans        &trans        &tog KB_CONFIG  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
