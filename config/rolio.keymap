#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <locale/keys_ru.h>

#define ENGLISH   0
#define FKEYS     1
#define NUMBERS   2
#define RUSSIAN   3
#define W_FKEYS   4
#define W_NUMBERS 5
#define MATHS     6
#define KB_CONFIG 7

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";

        ru_fkeys {
            if-layers = <RUSSIAN FKEYS>;
            then-layer = <W_FKEYS>;
        };

        ru_numbers {
            if-layers = <RUSSIAN NUMBERS>;
            then-layer = <W_NUMBERS>;
        };
    };

    behaviors {
        // Toggle F-Keys Layer

        td_func_settings: tap_dance_func_settings {
            compatible = "zmk,behavior-tap-dance";
            label = "TAP_DANCE_FUNC_SETTINGS";
            #binding-cells = <0>;
            tapping-term-ms = <300>;
            bindings = <&mo FKEYS>, <&tog FKEYS>, <&tog KB_CONFIG>;
        };

        // Toggle Numbers layer

        td_math_numbers: tap_dance_math_numbers {
            compatible = "zmk,behavior-tap-dance";
            label = "TAP_DANCE_MATS_NUMBERS";
            #binding-cells = <0>;
            tapping-term-ms = <300>;
            bindings = <&mo NUMBERS>, <&tog MATHS>, <&tog NUMBERS>;
        };

        // Toggle capsword left

        td2: tap_dance_2 {
            compatible = "zmk,behavior-tap-dance";
            label = "TAP_DANCE_2";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp LSHFT>, <&caps_word>;
        };

        // Toggle capsword right

        td3: tap_dance_3 {
            compatible = "zmk,behavior-tap-dance";
            label = "TAP_DANCE_3";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp RSHFT>, <&caps_word>;
        };

        // Toggle Russian layer

        td_en_ru: tap_dance_en_ru {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_EN_RU";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp LGUI>, <&tog RUSSIAN>;
        };

        // Toggle Windows layer

        td5: tap_dance_5 {
            compatible = "zmk,behavior-tap-dance";
            label = "TAP_DANCE_5";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp RGUI>, <&tog RUSSIAN>;
        };

        // Backspace a whole word when holding backspace

        backspace_word: backspace_word {
            compatible = "zmk,behavior-hold-tap";
            label = "BACKSPACE_WORD";
            #binding-cells = <2>;
            tapping_term_ms = <135>;
            quick_tap_ms = <0>;
            flavor = "tap-preferred";
            bindings = <&bsp_word>, <&kp>;
        };

        w_backspace_word: w_backspace_word {
            compatible = "zmk,behavior-hold-tap";
            label = "WINDOWS_BACKSPACE_WORD";
            #binding-cells = <2>;
            tapping_term_ms = <135>;
            quick_tap_ms = <0>;
            flavor = "tap-preferred";
            bindings = <&w_bsp_word>, <&kp>;
        };

        // Mac OS Word Seek

        mac_word_seek: mac_word_seek {
            compatible = "zmk,behavior-sensor-rotate";
            label = "MAC_WORD_SEEK";
            #sensor-binding-cells = <0>;
            bindings = <&prev_word>, <&next_word>;
        };

        //Windows Word Seek

        win_word_seek: win_word_seek {
            compatible = "zmk,behavior-sensor-rotate";
            label = "WIN_WORD_SEEK";
            #sensor-binding-cells = <0>;
            tap-ms = <20>;
            bindings = <&w_prev_word>, <&w_next_word>;
        };

        //Mac OS Zoom

        mac_zoom: mac_zoom {
            compatible = "zmk,behavior-sensor-rotate";
            label = "MAC_ZOOM";
            #sensor-binding-cells = <0>;
            bindings = <&zoom_in>, <&zoom_out>;
        };

        //Windows OS Zoom

        win_zoom: win_zoom {
            compatible = "zmk,behavior-sensor-rotate";
            label = "WINDOWS_ZOOM";
            #sensor-binding-cells = <0>;
            bindings = <&w_zoom_in>, <&w_zoom_out>;
        };

        td_e_yo: td_e_yo {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_E_YO";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp T>, <&kp GRAVE>;
        };

        td_mzn_tzn: td_mzn_tzn {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_MZN_TZN";
            #binding-cells = <0>;
            tapping-term-ms = <175>;
            bindings = <&kp M>, <&kp RBKT>;
        };

        ht_hrm_left: ht_hrm_left {
            compatible = "zmk,behavior-hold-tap";
            label = "HT_HRM_LEFT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <300>;
            flavor = "balanced";
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <37 23 11 10 22 36 35 21 9 8 20 34 33 19 7 6 18 32 31 43 44 45 46 47>;
        };

        ht_hrm_right: ht_hrm_right {
            compatible = "zmk,behavior-hold-tap";
            label = "HT_HRM_RIGHT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <300>;
            flavor = "balanced";
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <42 30 29 41 17 5 4 16 28 40 39 27 15 3 2 14 26 38 25 13 1 0 12 24>;
        };
    };

    macros {
        unindent: unindent {
            label = "UNINDENT";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LSHIFT>,
                <&macro_tap>,
                <&kp TAB>,
                <&macro_release>,
                <&kp LSHIFT>;
        };

        lstart: lstart {
            label = "Line_Start";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LGUI>,
                <&macro_tap>,
                <&kp LEFT>,
                <&macro_release>,
                <&kp LGUI>;
        };

        lend: lend {
            label = "Line_End";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LGUI>,
                <&macro_tap>,
                <&kp RIGHT>,
                <&macro_release>,
                <&kp LGUI>;
        };

        scrsh: scrsh {
            label = "Screenshot";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LGUI>,
                <&macro_press>,
                <&kp LSHIFT>,
                <&macro_tap>,
                <&kp N3>,
                <&macro_release>,
                <&kp LSHFT>,
                <&macro_release>,
                <&kp LGUI>;
        };

        scrcr: scrcr {
            label = "Screen_Crop";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LGUI>,
                <&macro_press>,
                <&kp LSHIFT>,
                <&macro_tap>,
                <&kp N4>,
                <&macro_release>,
                <&kp LSHFT>,
                <&macro_release>,
                <&kp LGUI>;
        };

        wscrcr: wscrcr {
            label = "Windows_Screen_Crop";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LGUI>,
                <&macro_press>,
                <&kp LSHIFT>,
                <&macro_tap>,
                <&kp S>,
                <&macro_release>,
                <&kp LSHFT>,
                <&macro_release>,
                <&kp LGUI>;
        };

        pal: pal {
            label = "Pallette";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LGUI>,
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_tap>,
                <&kp SPACE>,
                <&macro_release>,
                <&kp LCTRL>,
                <&macro_release>,
                <&kp LGUI>;
        };

        wpal: wpal {
            label = "W_Pallette";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LGUI>,
                <&macro_tap>,
                <&kp DOT>,
                <&macro_release>,
                <&kp LGUI>;
        };

        // Word backspace macros

        bsp_word: bsp_word {
            label = "BSP_WORD";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp BSPC>,
                <&macro_release>,
                <&kp LALT>;
        };

        w_bsp_word: w_bsp_word {
            label = "W_BSP_WORD";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_tap>,
                <&kp BSPC>,
                <&macro_release>,
                <&kp LCTRL>;
        };

        // Word seek macros

        prev_word: prev_word {
            label = "PREV_WORD";
            compatible = "zmk,behavior-macro";
            wait-ms = <2>;
            tap-ms = <20>;
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp LEFT>,
                <&macro_release>,
                <&kp LALT>;
        };

        next_word: next_word {
            label = "NEXT_WORD";
            compatible = "zmk,behavior-macro";
            wait-ms = <2>;
            tap-ms = <20>;
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp RIGHT>,
                <&macro_release>,
                <&kp LALT>;
        };

        w_prev_word: w_prev_word {
            label = "W_PREV_WORD";
            compatible = "zmk,behavior-macro";
            wait-ms = <2>;
            tap-ms = <20>;
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_tap>,
                <&kp LEFT>,
                <&macro_release>,
                <&kp LCTRL>;
        };

        w_next_word: w_next_word {
            label = "W_NEXT_WORD";
            compatible = "zmk,behavior-macro";
            wait-ms = <2>;
            tap-ms = <20>;
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_tap>,
                <&kp RIGHT>,
                <&macro_release>,
                <&kp LCTRL>;
        };

        // Zoom macros

        zoom_in: zoom_in {
            label = "ZOOM_IN";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LGUI>,
                <&macro_tap>,
                <&kp EQUAL>,
                <&macro_release>,
                <&kp LGUI>;
        };

        zoom_out: zoom_out {
            label = "ZOOM_OUT";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LGUI>,
                <&macro_tap>,
                <&kp MINUS>,
                <&macro_release>,
                <&kp LGUI>;
        };

        reset_zoom: reset_zoom {
            label = "RESET_ZOOM";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LGUI>,
                <&macro_tap>,
                <&kp N0>,
                <&macro_release>,
                <&kp LGUI>;
        };

        w_zoom_in: w_zoom_in {
            label = "WINDOWS_ZOOM_IN";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_tap>,
                <&kp EQUAL>,
                <&macro_release>,
                <&kp LCTRL>;
        };

        w_zoom_out: w_zoom_out {
            label = "WINDOWS_ZOOM_OUT";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_tap>,
                <&kp MINUS>,
                <&macro_release>,
                <&kp LCTRL>;
        };

        w_reset_zoom: w_reset_zoom {
            label = "WINDOWS_RESET_ZOOM";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_tap>,
                <&kp N0>,
                <&macro_release>,
                <&kp LCTRL>;
        };

        lng_en: lng_en {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_press>,
                <&kp LSHFT>,
                <&macro_tap>,
                <&kp N1>,
                <&macro_release>,
                <&kp LCTRL>,
                <&macro_release>,
                <&kp LSHFT>;

            label = "LNG_EN";
        };

        lng_ru: lng_ru {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_press>,
                <&kp LSHFT>,
                <&macro_tap>,
                <&kp N2>,
                <&macro_release>,
                <&kp LCTRL>,
                <&macro_release>,
                <&kp LSHFT>;

            label = "LNG_RU";
        };
    };

    combos {
        compatible = "zmk,combos";

        combo_ZX_ctrlC {
            bindings = <&kp LC(Z)>;
            key-positions = <25 26>;
            layers = <0 3>;
        };

        combo_XC_ctrlX {
            bindings = <&kp LC(X)>;
            key-positions = <26 27>;
            layers = <0 3>;
        };

        combo_CV_ctrlC {
            bindings = <&kp LC(C)>;
            key-positions = <27 28>;
            layers = <0 3>;
        };

        combo_VB_ctrlV {
            bindings = <&kp LC(V)>;
            key-positions = <29 28>;
            layers = <0 3>;
        };
    };

    layer_listeners {
        compatible = "zmk,layer-listeners";

        // Call &haptic_feedback_in on layer enter, and &haptic_feedback_out on layer leave
        en_layer_toggle {
            layers = <ENGLISH FKEYS NUMBERS> ;
            bindings = <&lng_en &none>;
        };

        // Call &reset_nav on NAV layer leave
        ru_layer_toggle {
            layers = <RUSSIAN>;
            bindings = <&lng_ru &none>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            label = "QWERTY";
            sensor-bindings = <&inc_dec_kp UP DOWN &inc_dec_kp LEFT RIGHT>;
            bindings = <
&kp ESC  &kp Q                &kp W                &kp E                 &kp R                 &td_e_yo                               &kp Y             &kp U                  &kp I                  &kp O                &kp P                   &kp BSPC
&kp TAB  &ht_hrm_left LGUI A  &ht_hrm_left LALT S  &ht_hrm_left LCTRL D  &ht_hrm_left LSHFT F  &kp G                                  &kp H             &ht_hrm_right RSHFT J  &ht_hrm_right RCTRL K  &ht_hrm_left RALT L  &ht_hrm_left LGUI SEMI  &kp FSLH
&lng_en  &kp Z                &kp X                &kp C                 &kp V                 &kp B              &kp F16    &kp F17  &kp N             &td_mzn_tzn            &kp COMMA              &kp DOT              &kp SQT                 &lng_ru
                              &td_en_ru          &kp LALT              &kp DEL               &td_func_settings  &kp SPACE  &kp RET  &td_math_numbers  &kp BSPC               &kp LBKT               &kp DEL
            >;
        };

        en_fkeys_layer {
            label = "En F Keys";
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &win_zoom>;
            bindings = <
&kp ESCAPE  &kp F1  &kp F2   &kp F3   &kp F4   &kp C_PP                               &none     &kp RSHIFT  &kp RCTRL  &kp RALT   &kp RGUI   &none
&bt BT_PRV  &kp F5  &kp F6   &kp F7   &kp F8   &kp C_NEXT                             &kp HOME  &kp UP      &kp END    &kp PSCRN  &kp PG_UP  &none
&bt BT_NXT  &kp F9  &kp F10  &kp F11  &kp F12  &kp C_PREV  &kp C_MUTE  &w_reset_zoom  &kp LEFT  &kp DOWN    &kp RIGHT  &wscrcr    &kp PG_DN  &none
                    &trans   &trans   &trans   &trans      &trans      &trans         &trans    &trans      &trans     &trans
            >;
        };

        en_numbers_layer {
            label = "En Numbers";
            sensor-bindings = <&inc_dec_kp UP DOWN &win_word_seek>;
            bindings = <
&kp UNDER  &kp N1    &kp N2          &kp N3           &kp N4    &kp N5                     &kp N6     &kp N7         &kp N8    &kp N9    &kp N0         &trans
&trans     &kp EXCL  &kp AT          &kp HASH         &kp DLLR  &kp PRCNT                  &kp CARET  &kp AMPERSAND  &kp STAR  &kp LPAR  &kp RPAR       &kp FSLH
&trans     &pal      &kp LEFT_BRACE  &kp RIGHT_BRACE  &kp PIPE  &kp EQUAL  &trans  &trans  &kp MINUS  &kp PLUS       &kp LBKT  &kp RBKT  &kp BACKSLASH  &kp DOT
                     &trans          &trans           &trans    &trans     &trans  &trans  &trans     &trans         &trans    &trans
            >;
        };

        ru_default_layer {
            label = "Russian";
            sensor-bindings = <&inc_dec_kp UP DOWN &inc_dec_kp LEFT RIGHT>;
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        ru_fkeys_layer {
            label = "Ru F Keys";
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &mac_zoom>;
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                       &trans   &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                       &lstart  &trans  &lend   &scrsh  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &reset_zoom  &trans   &trans  &trans  &scrcr  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans       &trans   &trans  &trans  &trans
            >;
        };

        ru_numbers_layer {
            label = "Ru Numbers";
            sensor-bindings = <&inc_dec_kp UP DOWN &mac_word_seek>;
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &wpal   &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        maths_layer {
            label = "Maths";
            sensor-bindings = <&inc_dec_kp UP DOWN &inc_dec_kp LEFT RIGHT>;
            bindings = <
&kp UNDER  &kp N1    &kp N2  &kp N3  &kp N4  &kp N5                     &kp N6      &kp N7         &kp N8    &kp N9    &kp N0    &trans
&trans     &kp EXCL  &trans  &trans  &trans  &kp PRCNT                  &kp CARET   &kp AMPERSAND  &kp STAR  &kp LPAR  &kp RPAR  &kp FSLH
&trans     &wpal     &trans  &trans  &trans  &kp EQUAL  &trans  &trans  &kp MINUS   &kp PLUS       &trans    &trans    &trans    &kp DOT
                     &trans  &trans  &trans  &trans     &trans  &trans  &tog MATHS  &trans         &trans    &trans
            >;
        };

        settings_layer {
            label = "Settings";
            sensor-bindings = <&inc_dec_kp UP DOWN &inc_dec_kp LEFT RIGHT>;
            bindings = <
&out OUT_TOG  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                    &trans  &trans  &trans  &trans  &trans  &trans
&trans        &bt BT_PRV    &bt BT_NXT    &trans        &trans        &trans                          &trans  &trans  &trans  &trans  &trans  &trans
&trans        &trans        &bt BT_CLR    &bl BL_DEC    &bl BL_TOG    &bl BL_INC      &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                            &trans        &trans        &trans        &tog KB_CONFIG  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
